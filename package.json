{
  "name": "dotsearch",
  "version": "0.2.0",
  "description": "增强搜索引擎用户体验的 UserScript（当前以 Bing 为主，逐步扩展 Google / 百度）",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:all": "node scripts/build.mjs --engine=all",
    "build:dev": "node scripts/build.mjs --dev",
    "release": "node scripts/build-engine.mjs bing && node scripts/verify-artifacts.mjs bing && node scripts/verify-release.mjs bing",
    "watch": "node scripts/build.mjs --watch --dev",
    "serve": "node scripts/serve.mjs",
    "check": "tsc --noEmit",
    "verify:strip": "node scripts/build.mjs --dev && node scripts/verify-strip.mjs",
    "verify:dark": "node scripts/build.mjs --dev && node scripts/verify-strip.mjs --dark",
    "verify:sanitize": "esbuild src/features/privacy.ts --bundle --format=esm --platform=neutral --outfile=.build/privacy-unit.mjs --log-level=silent && node scripts/verify-sanitize.mjs",
    "verify:settings": "node scripts/build-engine.mjs bing --dev && esbuild src/engines/bing.ts --bundle --format=esm --platform=node --outfile=.build/bing-unit.mjs --log-level=silent && node scripts/verify-settings.mjs",
    "verify:responsive": "node scripts/build-engine.mjs bing --dev && node scripts/verify-responsive.mjs",
    "verify:pagination": "node scripts/build-engine.mjs bing --dev && node scripts/verify-pagination.mjs",
    "verify:live": "node scripts/build.mjs --dev && node scripts/verify-live.mjs",
    "verify:start": "node scripts/build.mjs --dev && node scripts/verify-live.mjs --document-start",
    "verify:intl": "node scripts/build.mjs --dev && node scripts/verify-live.mjs --proxy --document-start",
    "verify:www4": "node scripts/build.mjs --dev && node scripts/verify-live.mjs --host=www4.bing.com --proxy --document-start",
    "verify:all": "node scripts/build.mjs --dev && node scripts/verify-strip.mjs && node scripts/verify-strip.mjs --dark && node scripts/verify-live.mjs --document-start",
    "sample": "node scripts/fetch-sample.mjs",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "verify": "npm run check && npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
